// /learn/sounds: the lessons' sounds, to audition. Not in the sidebar and not a lesson (no Nav, no Lesson); the
// SoundBoard widget is filled by client/lib/audition.ts, and the palette picked here is the one the lessons play
// (client/lib/sound.ts). Nothing here is narrated: it is a page of buttons that make sounds.
site {
  learn {
    sounds : Page {
      Narrow
      Title: {"Lesson sounds"}
      Description: {"Every sound the blaze lessons make, in each palette, to pick by ear."}
      Lede lede("Every sound the lessons make, in each palette. Play them, then pick the one the lessons use. Your pick stays in this browser.") {
        Silent
      }
      SoundBoard board
      Dim level("Each button shows the sound's loudest moment, measured in your browser. The loudest sit near -14 dB, well under the top.") {
        Silent
      }
    }
  }
}
