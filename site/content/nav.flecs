// The sidebar's sections, top to bottom by order (renderer core side.rs draws them). A page joins one with
// Nav: {label, order}, Icon and (InGroup, nav.<section>); a Link child of a section is a row that goes elsewhere.
// This file runs right after refs.flecs, so every page can name its section.
nav {
  overview {
    Group: {"Overview", 1}
    Icon: {"compass"}
    Link goals("Goals", "/#goals", 2) {
      Icon: {"target"}
    }
  }
  start {
    Group: {"Get started", 2}
    Icon: {"rocket"}
  }
  design {
    Group: {"Design", 3}
    Icon: {"books"}
  }
  bench {
    Group: {"Benchmarks", 4}
    Icon: {"gauge"}
  }
  community {
    Group: {"Community", 5}
    Icon: {"people"}
    Link github("GitHub", "https://github.com/indexable-inc/blaze", 9) {
      Icon: {"github"}
    }
  }
}
