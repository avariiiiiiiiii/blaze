// The site's pages. Each page is an entity under `site`; its path is its URL (site.index is /).
// RFCs live in rfcs/, the charter in charter.flecs, /bench in bench.flecs, /install and /usage in their own files.
// The sidebar's sections are in nav.flecs; a page joins one with Nav, Icon and (InGroup, nav.<section>).
site {
  OrderedChildren
  // https://ix.dev/blaze/ (the worker answers there; ra-jit.ix.dev and blaze.ix.dev redirect to it).
  Served: {"https://ix.dev", "/blaze"}
  // The pixel-fire wordmark (docs/brand/fire/gen.py), copied to static/brand/.
  Brand: {"/brand/blaze-dark.webp", "/brand/blaze-light.webp", 688, 368}

  index : Page {
    Hero
    Title: {"blaze"}
    Nav: {"Home", 1}
    Icon: {"house"}
    (InGroup, nav.overview)
    Intro: {"[warm, welcoming] Hey, welcome. [short pause] This is blaze: a Rust build that keeps cargo's commands and rebuilds in milliseconds. Here's what it's for."}
    Outro: {"[warm] So, the short version. Proc macros already run as cached, sandboxed WebAssembly. Builds are on their way to hermetic. An edit rebuilds only what it changed, in milliseconds, and the affected tests are next. And remote execution is still a plan. [breath] Same commands as cargo, one line to install. Thanks for listening."}
    Tab: {"blaze: Rust builds you can cache, in milliseconds"}
    Description: {"A Rust build with cargo's commands: proc macros as cached, sandboxed WebAssembly, hermetic builds, edits rebuilt in milliseconds, and remote execution to come."}

    Lede lede("Rebuild Rust in milliseconds, with the same commands as cargo. blaze is built toward four goals: proc macros whose output can be cached, hermetic builds, rebuilds and test runs that redo only what an edit touched, and remote execution for the long jobs.") {
      Say: {"[curious] Here's the idea. You type the same commands as cargo, with blaze in front, and an edit is rebuilt in milliseconds. [pause] Behind that are four goals. Proc macros whose output can be cached. Builds that are hermetic. Rebuilds and test runs that redo only what an edit touched. And, later, sending the long builds and test runs to other machines. [calm] Let's take them one at a time."}
    }
    Command install("curl -fsSL https://ix.dev/blaze | sh") {
      Silent
    }
    Dim then("Then `blaze run` in any Rust project. [Install](/install) has the other ways in and what you need; [Usage](/usage) has the day to day.") {
      Say: {"[warm] Installing is the one line at the top: it fetches blaze, and the Rust it builds with. Then type blaze run in any Rust project. The install and usage pages have the rest."}
    }

    Section goals(title: "Goals") {
      P intro("What blaze is for, and where each part stands. **Shipped** works today, **Underway** works in part, **Planned** is not built yet.") {
        Say: {"[thoughtful] So, the goals. For each one: what it is, why it matters, and where it honestly stands today. Some of it works now, some of it in part, and one is still a plan."}
      }

      Goal proc_macros(title: "Cacheable proc macros") {
        Icon: {"cube"}
        (Status, Shipped)
        Say: {"[confident] Goal one: proc macros you can cache. [short pause] blaze builds each proc macro from its source as a WebAssembly module, and runs it in its own process. The macro can read its own package and the variables cargo sets, and nothing else. Its clock reads zero, and its random numbers are the same every run. [pause] Why bother? A normal proc macro is native code that can touch anything and answer differently each time, so nothing can safely keep its output. A sandboxed, deterministic one can be cached like a pure function. [warm] And that's on by default today. Each expansion is kept in blaze's store, and so is the compiled module. [short pause] What's missing: for now only the same checkout finds the cache, and a macro that can't run as WebAssembly fails the build unless you list it as native."}
        P what("**What.** blaze builds each proc macro from its source as a WebAssembly module and expands it in its own process, under Wasmtime. The module can read its package directory and the variables cargo sets, nothing more; its clock reads 0 and its random bytes are the same on every run.")
        P why("**Why it matters.** A native proc macro can read and write anything and answer differently each time, so nothing can safely keep its output. A sandboxed, deterministic one can be cached like a pure function, and it stays out of the rest of the machine.")
        P now("**Where it stands.** On by default. Each expansion is kept in blaze's store, keyed on the module, the macro, its input and the files it read, and the compiled module is kept too, so a new process loads one in about 3 ms. Not yet: only the same checkout finds the cache, and an expansion that asked the compiler about a span is not kept. A macro that cannot run as wasm fails the build unless its package is listed in `native-proc-macros` ([details](https://github.com/indexable-inc/blaze/blob/main/docs/cargo.md#proc-macros-run-as-webassembly)).")
      }

      Goal hermetic(title: "Hermetic builds") {
        Icon: {"shield"}
        (Status, Underway)
        Say: {"[thoughtful] Goal two: hermetic builds. A build's output should depend only on its inputs: your source, your dependencies at their locked versions, and blaze's own pinned toolchain. Never on whatever else happens to be on the machine. [pause] That's what makes a build safe to cache and share, and it means a build script can't quietly read your home directory or call the network. [short pause] Where is it? Build scripts and proc macros run in a sandbox by default, on Linux and on macOS, and a build script writes only its own output directory. Every project builds with blaze's pinned nightly, whatever it pins. [serious] Not done yet: tests run sandboxed only as an opt-in experiment, Windows has no sandbox, and the Rust compiler still does part of the work, like the standard library."}
        P what("**What.** A build's output depends only on its inputs: the source, the dependencies at their locked versions and blaze's own pinned toolchain, never on what else is on the machine.")
        P why("**Why it matters.** The same inputs giving the same output is what lets a build be cached and shared, and a sandbox means a build script cannot quietly read your home directory or the network.")
        P now("**Where it stands.** Build scripts and proc macros run in a sandbox by default: Linux namespaces with a seccomp filter, macOS Seatbelt. A build script sees the machine read-only and writes only its `OUT_DIR` ([details](https://github.com/indexable-inc/blaze/blob/main/docs/cargo.md#build-scripts-and-proc-macros-run-in-a-sandbox)). Every project builds with blaze's pinned nightly, whatever it pins. Not yet: tests run sandboxed only in an opt-in experiment, Windows has no sandbox, and rustc still does part of the work, such as the standard library ([the plan](https://github.com/indexable-inc/blaze/blob/main/docs/no-rustc.md)).")
      }

      Goal incremental(title: "Fast incremental builds and tests") {
        Icon: {"timer"}
        (Status, Shipped)
        Say: {"[upbeat] Goal three: fast incremental builds, and fast test runs. After the first build, an edit recompiles only the functions it changed, and writes them into the program that's already built, instead of linking it all over again. And a test run should rerun only the tests the edit could affect. [pause] Why? Because the wait between an edit and a result is where the time goes, for people, and for agents running builds in a loop. [excited] Function-level rebuilds are on by default today; you'll see the numbers in a moment. [short pause] Running only the affected tests works too, when you ask for it. The catch: a test's pass is only kept when the test ran in the sandbox, so for now that needs the sandboxed tests experiment. Otherwise every test runs, every time."}
        P what("**What.** After the first build, an edit recompiles only the functions it changed and writes them into the program already built, instead of linking it again. A test run reruns only the tests the edit could have changed.")
        P why("**Why it matters.** The wait between an edit and a result is where the time goes, for people and for agents running builds in a loop. Milliseconds instead of seconds changes how you work.")
        P now("**Where it stands.** Function-level rebuilds are on by default ([numbers below](#speed)). Running only the affected tests works with `BLAZE_TESTS=affected`, but a pass is kept only for a test that ran sandboxed, so for now it needs the sandboxed-tests experiment; otherwise every test runs every time ([details](https://github.com/indexable-inc/blaze/blob/main/docs/cargo.md#running-only-the-tests-that-have-not-passed)).")
      }

      Goal remote(title: "Remote execution") {
        Icon: {"cloud"}
        (Status, Planned)
        Say: {"[thoughtful] And goal four: remote execution. The long-running work, full builds and big test suites, sent to other machines over the remote execution protocol that Bazel and its build farms speak. [pause] A cold build of a large workspace shouldn't be bound by one laptop, and work some machine has already done shouldn't be done again. [calm] This one is planned, not built. What comes first is the remote cache: its server is up, and blaze can push to it and pull from it, though C I doesn't use it yet. It speaks blaze's own protocol for now. Remote execution itself is still to come."}
        P what("**What.** Long-running work, full builds and test suites, sent to other machines over the Remote Execution API (REAPI), the protocol Bazel and its build farms speak.")
        P why("**Why it matters.** A cold build of a large workspace or a long test suite should not be bound by one laptop, and work some machine already did should not be done again.")
        P now("**Where it stands.** Planned. The remote cache comes first: its gateway is deployed, and blaze pushes to it and pulls from it (`BLAZE_REMOTE`), though CI does not use it yet ([design](https://github.com/indexable-inc/blaze/blob/main/docs/remote-cache.md)). It speaks blaze's own protocol; remote execution over REAPI is not built ([#226](https://github.com/indexable-inc/blaze/issues/226)).")
      }
    }

    Section speed(title: "How fast") {
      Say: {"[curious] So how fast is it? [breath] Take a workspace of two hundred crates, edit one function, and build. [matter-of-fact] In the main crate, cargo takes about one point eight seconds. blaze, four tenths. [pause] In a crate everything depends on, the painful case, cargo takes over six seconds. [excited] blaze, six tenths. [calm] That was measured once, by hand. The benchmark history page has every run on real projects, next to plain cargo."}
      Dim setup("Edit one function, then build. A generated 200-crate workspace on Linux x86-64 with 8 CPUs, median of three, measured once by hand.")
      Table numbers {
        Tr head { Th a("Edit"); Th b("cargo"); Th c("blaze") }
        Tr main_crate { Td a("Function in the main crate"); Td b("1.76 s"); Td c("0.42 s") }
        Tr deep_crate { Td a("Function in a crate everything depends on"); Td b("6.33 s"); Td c("0.60 s") }
      }
      Dim history("[Benchmark history](/bench): every run on real projects, next to plain cargo on the same machine.")
    }

    Section live(title: "Change a running program") {
      Say: {"[warm] One more thing blaze can do. A program that links the live edits crate takes each edit while it runs, with its state intact: save, build, and the next poll swaps in the changed functions, usually in under a millisecond. It's great for games, GUIs, anything slow to get back to where you were. [short pause] It works on macOS on Apple silicon today, and Linux and Windows support comes with the next release."}
      P what("A program that links the `ra-jit-live` crate takes each edit while it runs, state intact: save, build, and the next `poll` swaps in the functions that changed, usually in under a millisecond. For games, GUIs and anything slow to get back to where you were. It works on macOS on Apple silicon; Linux x86-64 and Windows x86-64 support is on main and comes with the next release. [How to use it](/usage#live).")
    }

    Section next(title: "Designed in the open") {
      Say: {"[thoughtful] And it's all designed in the open. blaze is a superset of Rust, and what it adds, it adds out loud: the charter says what it holds to, and the RFCs are designs still being argued about. [warm] Sign in with GitHub, and you can comment on any paragraph."}
      P charter("blaze is a superset of Rust. What it adds, it adds in the open: the [charter](/charter) says what we hold to, and [the RFCs](/rfcs) are the designs being argued about. Sign in with GitHub to comment on any paragraph.")
    }

    Section credits(title: "Credits") {
      Say: {"[warm, grateful] And credit where it's due. blaze includes code from rust-analyzer, Cranelift, LLVM and inkwell, salsa, object, Rust, and DioxusLabs' rustd. Thank you to the people who built them; none of them endorses blaze. It's made at ix, for den's native app. [small laugh] And this site? It's Flecs scripts, rendered by a little Rust renderer compiled to wasm."}
      Dim thanks("blaze stands on the shoulders of giants. Thank you to the people who built [rust-analyzer](https://github.com/rust-lang/rust-analyzer), [Cranelift](https://cranelift.dev), [LLVM](https://llvm.org) and [inkwell](https://github.com/TheDan64/inkwell), [salsa](https://github.com/salsa-rs/salsa), [object](https://github.com/gimli-rs/object), [Rust](https://github.com/rust-lang/rust), and [rustd](https://github.com/DioxusLabs/rustd) (DioxusLabs), whose code blaze includes. None of these projects endorses blaze. blaze was called ra-jit until 2026-10-24, and `cargo ra-jit` still works. Made at [ix](https://ix.dev) for den's native app. MIT or Apache-2.0. This site is [Flecs](https://github.com/SanderMertens/flecs) scripts, rendered by a Rust renderer compiled to wasm.")
    }
  }

  updates : Page {
    Narrow
    Title: {"Tell us you use blaze"}
    Nav: {"Updates", 1}
    Icon: {"envelope"}
    (InGroup, nav.community)
    Description: {"Leave your email and why you want to use blaze."}
    Lede lede("Leave your email and why you want it. It helps us see who uses blaze.")
    SignupForm form
    Dim privacy("We keep your email and answers to see who uses blaze, and may write to you about it. We don't share them.")
  }

  rfcs : Page {
    Title: {"RFCs"}
    Nav: {"RFCs", 2}
    Icon: {"files"}
    (InGroup, nav.design)
    Description: {"Designs for what blaze adds to Rust, open for comment."}
    Lede lede("Designs for what blaze adds to Rust. Each one is a draft until it is not: sign in with GitHub and comment on any paragraph, or on the RFC as a whole.")
    P charter("Read the [charter](/charter) first: it says what every RFC has to keep.")
    RfcIndex list
    Dim source("Each RFC is a Flecs script in [site/content/rfcs](https://github.com/indexable-inc/blaze/tree/main/site/content/rfcs). To propose one, open a pull request with a new file.")
  }

  "404" : Page {
    Title: {"Not found"}
    P gone("Nothing here. Try the [home page](/) or [the RFCs](/rfcs).")
  }
}
